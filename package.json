{
  "name": "celcius-ai",
  "productName": "Celcius",
  "version": "0.1.2",
  "description": "Celcius - asisten AI berkarakter VRM",
  "author": "Reamura",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/copy-libs.js",
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "release": "npm version patch -m \"v%s\" && git push --follow-tags"
  },
  "build": {
    "appId": "com.reamura.celcius",
    "productName": "Celcius",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.json",
      "web/**/*"
    ],
    "extraResources": [
      {
        "from": "llama",
        "to": "llama"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "reamura87",
      "repo": "Celcius-Project",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.3.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "three": "^0.169.0"
  }
}
